
<!DOCTYPE html>
<html>
<head>
    <title>Student Dashboard</title>
   
<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
        background: #121820;
        color: #e5e7eb;
        padding: 30px;
        margin: 0;
    }

    .container {
        background: #1e293b;
        padding: 30px;
        border: 1px solid #334155;
        border-radius: 10px;
        max-width: 900px;
        margin: auto;
    }

    h1 {
        color: #ffffff;
        margin-bottom: 10px;
    }

    h2 {
        color: #cbd5e1;
        margin-top: 30px;
    }

    .card {
        background: #263449;
        padding: 22px;
        margin: 20px 0;
        border: 1px solid #3b4b63;
        border-radius: 8px;
    }

    .card h3 {
        color: #cbd5e1;
        margin-top: 0;
    }

    .card h1 {
        color: #60a5fa;
        font-size: 36px;
    }

    .class-card {
        background: #263449;
        border: 1px solid #3b4b63;
        padding: 18px;
        margin: 12px 0;
        border-radius: 8px;
    }

    .class-card strong {
        font-size: 17px;
        color: #ffffff;
    }

    .class-card p {
        color: #cbd5e1;
    }

    a {
        text-decoration: none;
        color: #60a5fa;
    }

    a:hover {
        color: #93c5fd;
    }

    .button {
        background: #2563eb;
        color: white;
        padding: 11px 18px;
        border-radius: 6px;
        display: inline-block;
        margin: 5px;
    }

    .button:hover {
        background: #1d4ed8;
        color: white;
    }

    hr {
        border: 0;
        border-top: 1px solid #334155;
        margin: 25px 0;
    }
</style>

</head>

<body>

<div class="container">

    <h1>Student Management System</h1>
    <h2>Dashboard</h2>

    <div class="card">
        <h3>Total Students</h3>
        <h1><%= totalStudents %></h1>
    </div>

    <h2>Students in Each Class</h2>

    <% if (classCounts.length > 0) { %>

        <% classCounts.forEach((c) => { %>

            <div class="class-card">

                <strong>Class <%= c.className %></strong>

                <p>Students: <%= c.count %></p>

                <a href="/classes/<%= c.className %>">
    View Students
</a>

            </div>

        <% }) %>

    <% } else { %>

        <p>No students added yet.</p>

    <% } %>

    <hr>

    <a class="button" href="/students">All Students</a>
    <a class="button" href="/students/add">Add Student</a>

</div>

</body>
</html>
