
<!DOCTYPE html>
<html>
<head>
    <title>Add Student</title>

    
<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
        background: #121820;
        color: #e5e7eb;
        padding: 30px;
        margin: 0;
    }

    .container {
        background: #1e293b;
        padding: 30px;
        border: 1px solid #334155;
        border-radius: 10px;
        max-width: 480px;
        width: 100%;
        margin: auto;
    }

    h1 {
        color: #ffffff;
        margin-top: 0;
        margin-bottom: 25px;
    }

    input, select, textarea {
        width: 100%;
        padding: 12px;
        margin: 10px 0;
        background: #121c2b;
        color: #ffffff;
        border: 1px solid #475569;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
    }

    input:focus, select:focus, textarea:focus {
        border-color: #3b82f6;
    }

    input::placeholder, textarea::placeholder {
        color: #94a3b8;
    }

    select option {
        background: #1e293b;
        color: white;
    }

    textarea {
        min-height: 90px;
        resize: vertical;
    }

    button {
        background: #2563eb;
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 15px;
    }

    button:hover {
        background: #1d4ed8;
    }

    a {
        color: #60a5fa;
        text-decoration: none;
        margin-left: 12px;
    }

    a:hover {
        color: #93c5fd;
    }
</style>

</head>

<body>

<div class="container">

    <h1>Add Student</h1>

    <form action="/students/add" method="POST">

        <input
            type="text"
            name="name"
            placeholder="Student Name"
            required
        >

        <input
            type="text"
            name="rollNo"
            placeholder="Roll Number"
            required
        >

        <input
            type="text"
            name="className"
            placeholder="Class (Example: 10A)"
            required
        >

        <input
            type="number"
            name="age"
            placeholder="Age"
            min="1"
            required
        >

        <select name="gender" required>
            <option value="">Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>

        <input
            type="text"
            name="phone"
            placeholder="Phone Number"
        >

        <textarea
            name="address"
            placeholder="Address"
        ></textarea>

        <button type="submit">Add Student</button>

        <a href="/">Back</a>

    </form>

</div>

</body>
</html>
